#: src/omega_scan/domain/checks/cookies/service.py:49
#, python-brace-format
msgid "Cookie sans attribut Secure : {get}"
msgstr "Cookie senza attributo Secure: {get}"

#: src/omega_scan/domain/checks/cookies/service.py:55
#, python-brace-format
msgid "Le cookie '{get}' est posé sur une réponse HTTPS sans l'attribut Secure."
msgstr "Il cookie '{get}' è impostato su una risposta HTTPS senza l'attributo Secure."

#: src/omega_scan/domain/checks/cookies/service.py:57
msgid "Le cookie peut être transmis en clair si le site est aussi accessible en HTTP."
msgstr "Il cookie può essere trasmesso in chiaro se il sito è accessibile anche via HTTP."

#: src/omega_scan/domain/checks/cookies/service.py:59
msgid "Ajouter l'attribut Secure à ce cookie."
msgstr "Aggiungere l'attributo Secure a questo cookie."

#: src/omega_scan/domain/checks/cookies/service.py:91
#, python-brace-format
msgid "Cookie sans attribut HttpOnly : {get}"
msgstr "Cookie senza attributo HttpOnly: {get}"

#: src/omega_scan/domain/checks/cookies/service.py:96
#, python-brace-format
msgid "Le cookie '{get}' n'a pas l'attribut HttpOnly."
msgstr "Il cookie '{get}' non ha l'attributo HttpOnly."

#: src/omega_scan/domain/checks/cookies/service.py:97
msgid "Le cookie est accessible en JavaScript, ce qui aggrave l'impact d'un XSS."
msgstr "Il cookie è accessibile da JavaScript, il che aggrava l'impatto di un XSS."

#: src/omega_scan/domain/checks/cookies/service.py:99
msgid "Ajouter l'attribut HttpOnly si ce cookie n'est pas requis côté client."
msgstr "Aggiungere l'attributo HttpOnly se questo cookie non serve lato client."

#: src/omega_scan/domain/checks/cookies/service.py:132
msgid "l'attribut SameSite est absent"
msgstr "manca l'attributo SameSite"

#: src/omega_scan/domain/checks/cookies/service.py:134
msgid "SameSite=None est déclaré sans l'attribut Secure"
msgstr "SameSite=None è dichiarato senza l'attributo Secure"

#: src/omega_scan/domain/checks/cookies/service.py:140
#, python-brace-format
msgid "Cookie à risque CSRF : {get}"
msgstr "Cookie a rischio CSRF: {get}"

#: src/omega_scan/domain/checks/cookies/service.py:145
#, python-brace-format
msgid "Le cookie '{get}' est à risque : {reason}."
msgstr "Il cookie '{get}' è a rischio: {reason}."

#: src/omega_scan/domain/checks/cookies/service.py:146
msgid "Le cookie peut être envoyé lors de requêtes intersites, favorisant les attaques CSRF."
msgstr "Il cookie può essere inviato nelle richieste cross-site, favorendo gli attacchi CSRF."

#: src/omega_scan/domain/checks/cookies/service.py:148
msgid "Définir SameSite=Lax ou Strict, ou SameSite=None accompagné de Secure."
msgstr "Impostare SameSite=Lax o Strict, oppure SameSite=None insieme a Secure."

#: src/omega_scan/domain/checks/cors/service.py:47
msgid "CORS wildcard combiné à des credentials autorisés"
msgstr "Wildcard CORS combinato con credenziali autorizzate"

#: src/omega_scan/domain/checks/cors/service.py:53
msgid "Access-Control-Allow-Origin: * est combiné à Access-Control-Allow-Credentials: true."
msgstr "Access-Control-Allow-Origin: * è combinato con Access-Control-Allow-Credentials: true."

#: src/omega_scan/domain/checks/cors/service.py:56
msgid "N'importe quel site tiers peut lire des réponses authentifiées de l'utilisateur."
msgstr "Qualsiasi sito di terze parti può leggere le risposte autenticate dell'utente."

#: src/omega_scan/domain/checks/cors/service.py:58
msgid "Ne jamais combiner un wildcard avec Allow-Credentials ; whitelister les origines."
msgstr "Non combinare mai un wildcard con Allow-Credentials; mettere le origini in una whitelist."

#: src/omega_scan/domain/checks/cors/service.py:83
msgid "Origine arbitraire réfléchie dans Access-Control-Allow-Origin"
msgstr "Origine arbitraria riflessa in Access-Control-Allow-Origin"

#: src/omega_scan/domain/checks/cors/service.py:89
msgid "Le service reflète telle quelle une origine arbitraire et non reconnue dans Access-Control-Allow-Origin."
msgstr "Il servizio riflette così com'è un'origine arbitraria e non riconosciuta in Access-Control-Allow-Origin."

#: src/omega_scan/domain/checks/cors/service.py:92
msgid "Absence apparente de validation d'origine : un site tiers peut lire les réponses."
msgstr "Apparente assenza di convalida dell'origine: un sito di terze parti può leggere le risposte."

#: src/omega_scan/domain/checks/cors/service.py:94
msgid "Valider l'origine reçue contre une liste explicite avant de la réfléchir."
msgstr "Convalidare l'origine ricevuta rispetto a un elenco esplicito prima di rifletterla."

#: src/omega_scan/domain/checks/exposure/service.py:39
#, python-brace-format
msgid "Chemin admin accessible : {path}"
msgstr "Percorso di amministrazione accessibile: {path}"

#: src/omega_scan/domain/checks/exposure/service.py:44
#, python-brace-format
msgid "Le chemin {path} est accessible sans authentification."
msgstr "Il percorso {path} è accessibile senza autenticazione."

#: src/omega_scan/domain/checks/exposure/service.py:45
msgid "Interface d'administration potentiellement exposée."
msgstr "Interfaccia di amministrazione potenzialmente esposta."

#: src/omega_scan/domain/checks/exposure/service.py:46
msgid "Restreindre l'accès par IP ou exiger une authentification forte."
msgstr "Limitare l'accesso per IP o richiedere un'autenticazione forte."

#: src/omega_scan/domain/checks/exposure/service.py:87
#, python-brace-format
msgid "Fichier sensible accessible : {path}"
msgstr "File sensibile accessibile: {path}"

#: src/omega_scan/domain/checks/exposure/service.py:92
#, python-brace-format
msgid "Le fichier {path} est accessible publiquement."
msgstr "Il file {path} è accessibile pubblicamente."

#: src/omega_scan/domain/checks/exposure/service.py:93
msgid "Fuite de données sensibles (credentials, configuration)."
msgstr "Fuga di dati sensibili (credenziali, configurazione)."

#: src/omega_scan/domain/checks/exposure/service.py:94
msgid "Bloquer l'accès à ces fichiers via la configuration du serveur web."
msgstr "Bloccare l'accesso a questi file nella configurazione del server web."

#: src/omega_scan/domain/checks/headers/service.py:42
msgid "Content-Security-Policy absente"
msgstr "Content-Security-Policy assente"

#: src/omega_scan/domain/checks/headers/service.py:47
msgid "Le header Content-Security-Policy est absent sur une page HTML."
msgstr "L'header Content-Security-Policy manca su una pagina HTML."

#: src/omega_scan/domain/checks/headers/service.py:48
msgid "Vulnérable aux attaques XSS et injection de contenu."
msgstr "Vulnerabile agli attacchi XSS e all'iniezione di contenuto."

#: src/omega_scan/domain/checks/headers/service.py:49
msgid "Ajouter un header Content-Security-Policy restrictif."
msgstr "Aggiungere un header Content-Security-Policy restrittivo."

#: src/omega_scan/domain/checks/headers/service.py:99
msgid "Content-Security-Policy trop permissive"
msgstr "Content-Security-Policy troppo permissiva"

#: src/omega_scan/domain/checks/headers/service.py:104
#, python-brace-format
msgid "CSP présente mais contient des directives permissives: {join}"
msgstr "CSP presente ma contiene direttive permissive: {join}"

#: src/omega_scan/domain/checks/headers/service.py:105
msgid "La protection CSP est affaiblie."
msgstr "La protezione CSP è indebolita."

#: src/omega_scan/domain/checks/headers/service.py:106
msgid "Restreindre les directives CSP (éviter 'unsafe-inline', '*', etc.)."
msgstr "Limitare le direttive CSP (evitare 'unsafe-inline', '*', ecc.)."

#: src/omega_scan/domain/checks/headers/service.py:111
#, python-brace-format
msgid "Motifs permissifs détectés: {join}"
msgstr "Schemi permissivi rilevati: {join}"

#: src/omega_scan/domain/checks/headers/service.py:150
msgid "X-Content-Type-Options absent ou invalide"
msgstr "X-Content-Type-Options assente o non valido"

#: src/omega_scan/domain/checks/headers/service.py:155
msgid "Le header X-Content-Type-Options: nosniff est absent."
msgstr "Manca l'header X-Content-Type-Options: nosniff."

#: src/omega_scan/domain/checks/headers/service.py:156
msgid "Vulnérable aux attaques MIME sniffing."
msgstr "Vulnerabile agli attacchi di MIME sniffing."

#: src/omega_scan/domain/checks/headers/service.py:157
msgid "Ajouter le header: X-Content-Type-Options: nosniff"
msgstr "Aggiungere l'header: X-Content-Type-Options: nosniff"

#: src/omega_scan/domain/checks/headers/service.py:198 src/omega_scan/domain/checks/information_leaks/service.py:45
msgid "Bannière Server exposée"
msgstr "Banner Server esposto"

#: src/omega_scan/domain/checks/headers/service.py:203
#, python-brace-format
msgid "Le header Server expose des informations: {server}"
msgstr "L'header Server espone informazioni: {server}"

#: src/omega_scan/domain/checks/headers/service.py:204 src/omega_scan/domain/checks/information_leaks/service.py:51
msgid "Fuite d'information sur la technologie serveur."
msgstr "Fuga di informazioni sulla tecnologia del server."

#: src/omega_scan/domain/checks/headers/service.py:205 src/omega_scan/domain/checks/information_leaks/service.py:52
msgid "Configurer le serveur pour masquer ou minimiser le header Server."
msgstr "Configurare il server per nascondere o ridurre l'header Server."

#: src/omega_scan/domain/checks/headers/service.py:257
msgid "Cache-Control absent ou permissif"
msgstr "Cache-Control assente o permissivo"

#: src/omega_scan/domain/checks/headers/service.py:263
msgid "Le header Cache-Control est absent ou ne restreint pas explicitement la mise en cache (valeur observée : {cache_control!r})."
msgstr "L'header Cache-Control manca o non limita esplicitamente la memorizzazione in cache (valore osservato: {cache_control!r})."

#: src/omega_scan/domain/checks/headers/service.py:266
msgid "Du contenu potentiellement sensible pourrait être conservé par des caches partagés."
msgstr "Contenuti potenzialmente sensibili potrebbero essere conservati da cache condivise."

#: src/omega_scan/domain/checks/headers/service.py:268
msgid "Définir Cache-Control: no-store (ou private) sur les réponses porteuses de données utilisateur."
msgstr "Impostare Cache-Control: no-store (o private) sulle risposte che contengono dati utente."

#: src/omega_scan/domain/checks/information_leaks/service.py:50
#, python-brace-format
msgid "Le header Server expose des informations : {server}"
msgstr "L'header Server espone informazioni: {server}"

#: src/omega_scan/domain/checks/information_leaks/service.py:71
msgid "Bannière X-Powered-By exposée"
msgstr "Banner X-Powered-By esposto"

#: src/omega_scan/domain/checks/information_leaks/service.py:76
#, python-brace-format
msgid "Le header X-Powered-By expose des informations : {powered_by}"
msgstr "L'header X-Powered-By espone informazioni: {powered_by}"

#: src/omega_scan/domain/checks/information_leaks/service.py:77
