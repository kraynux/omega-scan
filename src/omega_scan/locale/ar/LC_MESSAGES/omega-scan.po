#: src/omega_scan/domain/checks/information_leaks/service.py:178
#, python-brace-format
msgid "Un stack trace est visible dans la réponse : {join}"
msgstr "تتبّع المكدّس ظاهر في الاستجابة: {join}"

#: src/omega_scan/domain/checks/information_leaks/service.py:179
msgid "Fuite d'information critique sur l'implémentation, paths internes, versions."
msgstr "تسرّب حرج لمعلومات عن التنفيذ والمسارات الداخلية والإصدارات."

#: src/omega_scan/domain/checks/information_leaks/service.py:181
msgid "Désactiver l'affichage des stack traces en production. Utiliser des pages d'erreur génériques."
msgstr "عطّل عرض تتبّع المكدّس في بيئة الإنتاج. استخدم صفحات خطأ عامة."

#: src/omega_scan/domain/checks/information_leaks/service.py:217
msgid "Fichier robots.txt présent"
msgstr "ملف robots.txt موجود"

#: src/omega_scan/domain/checks/information_leaks/service.py:222
