#: src/omega_scan/domain/checks/cookies/service.py:49
#, python-brace-format
msgid "Cookie sans attribut Secure : {get}"
msgstr "Cookie zonder Secure-attribuut: {get}"

#: src/omega_scan/domain/checks/cookies/service.py:55
#, python-brace-format
msgid "Le cookie '{get}' est posé sur une réponse HTTPS sans l'attribut Secure."
msgstr "De cookie '{get}' wordt in een HTTPS-antwoord gezet zonder het Secure-attribuut."

#: src/omega_scan/domain/checks/cookies/service.py:57
msgid "Le cookie peut être transmis en clair si le site est aussi accessible en HTTP."
msgstr "De cookie kan onversleuteld worden verzonden als de site ook via HTTP bereikbaar is."

#: src/omega_scan/domain/checks/cookies/service.py:59
msgid "Ajouter l'attribut Secure à ce cookie."
msgstr "Het Secure-attribuut aan deze cookie toevoegen."

#: src/omega_scan/domain/checks/cookies/service.py:91
#, python-brace-format
msgid "Cookie sans attribut HttpOnly : {get}"
msgstr "Cookie zonder HttpOnly-attribuut: {get}"

#: src/omega_scan/domain/checks/cookies/service.py:96
#, python-brace-format
msgid "Le cookie '{get}' n'a pas l'attribut HttpOnly."
msgstr "De cookie '{get}' heeft geen HttpOnly-attribuut."

#: src/omega_scan/domain/checks/cookies/service.py:97
msgid "Le cookie est accessible en JavaScript, ce qui aggrave l'impact d'un XSS."
msgstr "De cookie is toegankelijk via JavaScript, wat de impact van een XSS vergroot."

#: src/omega_scan/domain/checks/cookies/service.py:99
msgid "Ajouter l'attribut HttpOnly si ce cookie n'est pas requis côté client."
msgstr "Het HttpOnly-attribuut toevoegen als deze cookie aan de clientkant niet nodig is."

#: src/omega_scan/domain/checks/cookies/service.py:132
msgid "l'attribut SameSite est absent"
msgstr "het SameSite-attribuut ontbreekt"

#: src/omega_scan/domain/checks/cookies/service.py:134
msgid "SameSite=None est déclaré sans l'attribut Secure"
msgstr "SameSite=None is ingesteld zonder het Secure-attribuut"

#: src/omega_scan/domain/checks/cookies/service.py:140
#, python-brace-format
msgid "Cookie à risque CSRF : {get}"
msgstr "Cookie met CSRF-risico: {get}"

#: src/omega_scan/domain/checks/cookies/service.py:145
#, python-brace-format
msgid "Le cookie '{get}' est à risque : {reason}."
msgstr "De cookie '{get}' loopt risico: {reason}."

#: src/omega_scan/domain/checks/cookies/service.py:146
msgid "Le cookie peut être envoyé lors de requêtes intersites, favorisant les attaques CSRF."
msgstr "De cookie kan bij cross-site verzoeken worden meegestuurd, wat CSRF-aanvallen in de hand werkt."

#: src/omega_scan/domain/checks/cookies/service.py:148
msgid "Définir SameSite=Lax ou Strict, ou SameSite=None accompagné de Secure."
msgstr "SameSite=Lax of Strict instellen, of SameSite=None samen met Secure."

#: src/omega_scan/domain/checks/cors/service.py:47
msgid "CORS wildcard combiné à des credentials autorisés"
msgstr "CORS-wildcard gecombineerd met toegestane credentials"

#: src/omega_scan/domain/checks/cors/service.py:53
msgid "Access-Control-Allow-Origin: * est combiné à Access-Control-Allow-Credentials: true."
msgstr "Access-Control-Allow-Origin: * is gecombineerd met Access-Control-Allow-Credentials: true."

#: src/omega_scan/domain/checks/cors/service.py:56
msgid "N'importe quel site tiers peut lire des réponses authentifiées de l'utilisateur."
msgstr "Elke externe site kan de geauthenticeerde antwoorden van de gebruiker lezen."

#: src/omega_scan/domain/checks/cors/service.py:58
msgid "Ne jamais combiner un wildcard avec Allow-Credentials ; whitelister les origines."
msgstr "Combineer nooit een wildcard met Allow-Credentials; zet de origins op een whitelist."

#: src/omega_scan/domain/checks/cors/service.py:83
msgid "Origine arbitraire réfléchie dans Access-Control-Allow-Origin"
msgstr "Willekeurige origin weerspiegeld in Access-Control-Allow-Origin"

#: src/omega_scan/domain/checks/cors/service.py:89
msgid "Le service reflète telle quelle une origine arbitraire et non reconnue dans Access-Control-Allow-Origin."
msgstr "De dienst weerspiegelt een willekeurige, onbekende origin ongewijzigd in Access-Control-Allow-Origin."

#: src/omega_scan/domain/checks/cors/service.py:92
msgid "Absence apparente de validation d'origine : un site tiers peut lire les réponses."
msgstr "Ogenschijnlijk geen controle van de origin: een externe site kan de antwoorden lezen."

#: src/omega_scan/domain/checks/cors/service.py:94
msgid "Valider l'origine reçue contre une liste explicite avant de la réfléchir."
msgstr "De ontvangen origin controleren tegen een expliciete lijst voordat hij wordt weerspiegeld."

#: src/omega_scan/domain/checks/exposure/service.py:39
#, python-brace-format
msgid "Chemin admin accessible : {path}"
msgstr "Beheerpad bereikbaar: {path}"

#: src/omega_scan/domain/checks/exposure/service.py:44
#, python-brace-format
msgid "Le chemin {path} est accessible sans authentification."
msgstr "Het pad {path} is bereikbaar zonder authenticatie."

#: src/omega_scan/domain/checks/exposure/service.py:45
msgid "Interface d'administration potentiellement exposée."
msgstr "Beheerinterface mogelijk blootgesteld."

#: src/omega_scan/domain/checks/exposure/service.py:46
msgid "Restreindre l'accès par IP ou exiger une authentification forte."
msgstr "De toegang per IP beperken of sterke authenticatie vereisen."

#: src/omega_scan/domain/checks/exposure/service.py:87
#, python-brace-format
msgid "Fichier sensible accessible : {path}"
msgstr "Gevoelig bestand bereikbaar: {path}"

#: src/omega_scan/domain/checks/exposure/service.py:92
#, python-brace-format
msgid "Le fichier {path} est accessible publiquement."
msgstr "Het bestand {path} is publiek bereikbaar."

#: src/omega_scan/domain/checks/exposure/service.py:93
msgid "Fuite de données sensibles (credentials, configuration)."
msgstr "Lek van gevoelige gegevens (credentials, configuratie)."

#: src/omega_scan/domain/checks/exposure/service.py:94
msgid "Bloquer l'accès à ces fichiers via la configuration du serveur web."
msgstr "De toegang tot deze bestanden blokkeren in de configuratie van de webserver."

#: src/omega_scan/domain/checks/headers/service.py:42
msgid "Content-Security-Policy absente"
msgstr "Content-Security-Policy ontbreekt"

#: src/omega_scan/domain/checks/headers/service.py:47
msgid "Le header Content-Security-Policy est absent sur une page HTML."
msgstr "De header Content-Security-Policy ontbreekt op een HTML-pagina."

#: src/omega_scan/domain/checks/headers/service.py:48
msgid "Vulnérable aux attaques XSS et injection de contenu."
msgstr "Kwetsbaar voor XSS-aanvallen en content-injectie."

#: src/omega_scan/domain/checks/headers/service.py:49
msgid "Ajouter un header Content-Security-Policy restrictif."
msgstr "Een restrictieve Content-Security-Policy-header toevoegen."

#: src/omega_scan/domain/checks/headers/service.py:99
msgid "Content-Security-Policy trop permissive"
msgstr "Content-Security-Policy te ruim"

#: src/omega_scan/domain/checks/headers/service.py:104
#, python-brace-format
msgid "CSP présente mais contient des directives permissives: {join}"
msgstr "CSP aanwezig maar bevat ruime directives: {join}"

#: src/omega_scan/domain/checks/headers/service.py:105
msgid "La protection CSP est affaiblie."
msgstr "De CSP-bescherming is verzwakt."

#: src/omega_scan/domain/checks/headers/service.py:106
msgid "Restreindre les directives CSP (éviter 'unsafe-inline', '*', etc.)."
msgstr "De CSP-directives beperken ('unsafe-inline', '*' enz. vermijden)."

#: src/omega_scan/domain/checks/headers/service.py:111
#, python-brace-format
msgid "Motifs permissifs détectés: {join}"
msgstr "Ruime patronen gedetecteerd: {join}"

#: src/omega_scan/domain/checks/headers/service.py:150
msgid "X-Content-Type-Options absent ou invalide"
msgstr "X-Content-Type-Options ontbreekt of is ongeldig"

#: src/omega_scan/domain/checks/headers/service.py:155
msgid "Le header X-Content-Type-Options: nosniff est absent."
msgstr "De header X-Content-Type-Options: nosniff ontbreekt."

#: src/omega_scan/domain/checks/headers/service.py:156
msgid "Vulnérable aux attaques MIME sniffing."
msgstr "Kwetsbaar voor MIME-sniffing-aanvallen."

#: src/omega_scan/domain/checks/headers/service.py:157
msgid "Ajouter le header: X-Content-Type-Options: nosniff"
msgstr "De header toevoegen: X-Content-Type-Options: nosniff"

#: src/omega_scan/domain/checks/headers/service.py:198 src/omega_scan/domain/checks/information_leaks/service.py:45
