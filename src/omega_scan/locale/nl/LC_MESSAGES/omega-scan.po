msgstr "Het bestand /robots.txt is aanwezig en kan gevoelige paden onthullen."

#: src/omega_scan/domain/checks/information_leaks/service.py:224
msgid "Fuite d'information mineure sur la structure du site."
msgstr "Klein informatielek over de structuur van de site."

#: src/omega_scan/domain/checks/information_leaks/service.py:225
msgid "Vérifier que /robots.txt ne liste pas de chemins sensibles ou administratifs."
msgstr "Controleren dat /robots.txt geen gevoelige of administratieve paden opsomt."

#: src/omega_scan/domain/checks/information_leaks/service.py:233
#, python-brace-format
msgid "{get}://{get2}/robots.txt"
msgstr "{get}://{get2}/robots.txt"

#: src/omega_scan/domain/checks/information_leaks/service.py:262
msgid "Fichier security.txt présent"
msgstr "Bestand security.txt aanwezig"

#: src/omega_scan/domain/checks/information_leaks/service.py:267
msgid "Le fichier /.well-known/security.txt est présent (RFC 9116)."
msgstr "Het bestand /.well-known/security.txt is aanwezig (RFC 9116)."

#: src/omega_scan/domain/checks/information_leaks/service.py:268
msgid "Bonne pratique : facilite le signalement responsable de vulnérabilités."
msgstr "Goede praktijk: vergemakkelijkt het verantwoord melden van kwetsbaarheden."

#: src/omega_scan/domain/checks/information_leaks/service.py:269 src/omega_scan/domain/checks/transport/service.py:130
msgid "Aucune action requise."
msgstr "Geen actie vereist."

#: src/omega_scan/domain/checks/information_leaks/service.py:277
#, python-brace-format
msgid "{get}://{get2}/.well-known/security.txt"
msgstr "{get}://{get2}/.well-known/security.txt"

#: src/omega_scan/domain/checks/information_leaks/service.py:323
#, python-brace-format
msgid "Header technique exposé : {verbose_header}"
msgstr "Technische header blootgesteld: {verbose_header}"

#: src/omega_scan/domain/checks/information_leaks/service.py:328
#, python-brace-format
msgid "Le header {verbose_header} expose des informations techniques : {value}"
msgstr "De header {verbose_header} geeft technische informatie prijs: {value}"

#: src/omega_scan/domain/checks/information_leaks/service.py:330
msgid "Fuite d'information sur l'implémentation."
msgstr "Informatielek over de implementatie."

#: src/omega_scan/domain/checks/information_leaks/service.py:331
#, python-brace-format
msgid "Supprimer le header {verbose_header} de la configuration."
msgstr "De header {verbose_header} uit de configuratie verwijderen."

#: src/omega_scan/domain/checks/methods/policies.py:12
msgid "Méthode HTTP OPTIONS activée"
msgstr "HTTP-methode OPTIONS ingeschakeld"

#: src/omega_scan/domain/checks/methods/policies.py:15
msgid "La méthode OPTIONS est activée et peut révéler les méthodes autorisées."
msgstr "De methode OPTIONS is ingeschakeld en kan de toegestane methoden onthullen."

#: src/omega_scan/domain/checks/methods/policies.py:16
msgid "Fuite d'information mineure sur la configuration du serveur."
msgstr "Klein informatielek over de serverconfiguratie."

#: src/omega_scan/domain/checks/methods/policies.py:17
msgid "Désactiver la méthode OPTIONS si elle n'est pas nécessaire."
msgstr "De methode OPTIONS uitschakelen als die niet nodig is."

#: src/omega_scan/domain/checks/methods/policies.py:21
msgid "Méthode HTTP TRACE activée"
msgstr "HTTP-methode TRACE ingeschakeld"

#: src/omega_scan/domain/checks/methods/policies.py:24
msgid "La méthode TRACE est activée, ce qui peut faciliter les attaques Cross-Site Tracing (XST)."
msgstr "De methode TRACE is ingeschakeld, wat Cross-Site Tracing-aanvallen (XST) kan vergemakkelijken."

#: src/omega_scan/domain/checks/methods/policies.py:26
msgid "Risque de vol de cookies ou d'identifiants via XST."
msgstr "Risico op diefstal van cookies of inloggegevens via XST."

#: src/omega_scan/domain/checks/methods/policies.py:27
msgid "Désactiver la méthode TRACE dans la configuration du serveur web."
msgstr "De methode TRACE uitschakelen in de configuratie van de webserver."

#: src/omega_scan/domain/checks/methods/policies.py:31
msgid "Méthode HTTP PUT activée"
msgstr "HTTP-methode PUT ingeschakeld"

#: src/omega_scan/domain/checks/methods/policies.py:34
msgid "La méthode PUT est activée, permettant potentiellement l'upload de fichiers."
msgstr "De methode PUT is ingeschakeld, wat mogelijk het uploaden van bestanden toestaat."

#: src/omega_scan/domain/checks/methods/policies.py:36
msgid "Risque de dépôt de contenu malveillant ou de modification de ressources."
msgstr "Risico op het plaatsen van kwaadaardige inhoud of het wijzigen van bronnen."

#: src/omega_scan/domain/checks/methods/policies.py:37
msgid "Désactiver la méthode PUT sauf si explicitement requise et sécurisée."
msgstr "De methode PUT uitschakelen, tenzij uitdrukkelijk nodig en beveiligd."

#: src/omega_scan/domain/checks/methods/policies.py:41
msgid "Méthode HTTP DELETE activée"
msgstr "HTTP-methode DELETE ingeschakeld"

#: src/omega_scan/domain/checks/methods/policies.py:44
msgid "La méthode DELETE est activée, permettant potentiellement la suppression de ressources."
msgstr "De methode DELETE is ingeschakeld, wat mogelijk het verwijderen van bronnen toestaat."

#: src/omega_scan/domain/checks/methods/policies.py:46
msgid "Risque de suppression non autorisée de données."
msgstr "Risico op onbevoegd verwijderen van gegevens."

#: src/omega_scan/domain/checks/methods/policies.py:47
msgid "Désactiver la méthode DELETE sauf si explicitement requise et sécurisée."
msgstr "De methode DELETE uitschakelen, tenzij uitdrukkelijk nodig en beveiligd."

#: src/omega_scan/domain/checks/methods/policies.py:52
msgid "Méthode HTTP PATCH activée"
msgstr "HTTP-methode PATCH ingeschakeld"

#: src/omega_scan/domain/checks/methods/policies.py:55
msgid "La méthode PATCH est activée, permettant la modification partielle de ressources."
msgstr "De methode PATCH is ingeschakeld, wat gedeeltelijke wijziging van bronnen toestaat."

#: src/omega_scan/domain/checks/methods/policies.py:57
msgid "Risque de modification non autorisée de données."
msgstr "Risico op onbevoegd wijzigen van gegevens."

#: src/omega_scan/domain/checks/methods/policies.py:58
msgid "Désactiver la méthode PATCH sauf si explicitement requise et sécurisée."
msgstr "De methode PATCH uitschakelen, tenzij uitdrukkelijk nodig en beveiligd."

#: src/omega_scan/domain/checks/methods/policies.py:62
msgid "Méthode HTTP CONNECT activée"
msgstr "HTTP-methode CONNECT ingeschakeld"

#: src/omega_scan/domain/checks/methods/policies.py:65
msgid "La méthode CONNECT est activée, permettant l'établissement de tunnels TCP."
msgstr "De methode CONNECT is ingeschakeld, wat het opzetten van TCP-tunnels toestaat."

#: src/omega_scan/domain/checks/methods/policies.py:67
msgid "Risque d'utilisation du serveur comme proxy ouvert pour des attaques."
msgstr "Risico dat de server als open proxy voor aanvallen wordt gebruikt."

#: src/omega_scan/domain/checks/methods/policies.py:68
msgid "Restreindre la méthode CONNECT aux seuls ports nécessaires (ex: 443) ou la désactiver."
msgstr "De methode CONNECT beperken tot de benodigde poorten (bv. 443) of uitschakelen."

#: src/omega_scan/domain/checks/methods/service.py:49
msgid " Cependant, elle semble protégée par authentification."
msgstr " Ze lijkt echter door authenticatie beschermd te zijn."

#: src/omega_scan/domain/checks/methods/service.py:51
msgid "Risque mitigé par la présence d'une authentification."
msgstr "Risico beperkt door de aanwezigheid van authenticatie."

#: src/omega_scan/domain/checks/methods/service.py:52
msgid "Vérifier que l'authentification est robuste."
msgstr "Controleren dat de authenticatie robuust is."

#: src/omega_scan/domain/checks/methods/service.py:78
msgid " (statut incertain)"
msgstr " (status onzeker)"

#: src/omega_scan/domain/checks/methods/service.py:83
msgid " Le statut exact n'a pas pu être déterminé clairement."
msgstr " De exacte status kon niet duidelijk worden bepaald."

#: src/omega_scan/domain/checks/tls_depth/service.py:49
#, python-brace-format
msgid "Protocole TLS obsolète : {version}"
msgstr "Verouderd TLS-protocol: {version}"

#: src/omega_scan/domain/checks/tls_depth/service.py:54
#, python-brace-format
msgid "Le service négocie {version}, un protocole obsolète et vulnérable."
msgstr "De dienst onderhandelt {version}, een verouderd en kwetsbaar protocol."

#: src/omega_scan/domain/checks/tls_depth/service.py:55
msgid "Vulnérable aux attaques connues sur les protocoles TLS anciens (ex. POODLE, BEAST)."
msgstr "Kwetsbaar voor bekende aanvallen op oude TLS-protocollen (bv. POODLE, BEAST)."

#: src/omega_scan/domain/checks/tls_depth/service.py:57
msgid "Désactiver les protocoles antérieurs à TLSv1.2 côté serveur."
msgstr "Protocollen ouder dan TLSv1.2 aan de serverkant uitschakelen."

#: src/omega_scan/domain/checks/tls_depth/service.py:85
#, python-brace-format
msgid "Suite cryptographique faible : {cipher}"
msgstr "Zwakke cipher suite: {cipher}"

#: src/omega_scan/domain/checks/tls_depth/service.py:90
#, python-brace-format
msgid "La suite cryptographique négociée ({cipher}) est considérée faible."
msgstr "De onderhandelde cipher suite ({cipher}) wordt als zwak beschouwd."

#: src/omega_scan/domain/checks/tls_depth/service.py:91
msgid "Le chiffrement peut être cassé ou affaibli face à un attaquant motivé."
