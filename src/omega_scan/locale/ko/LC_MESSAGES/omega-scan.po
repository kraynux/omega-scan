msgstr "ID {scan_id!r}인 스캔을 찾을 수 없습니다."

#: src/omega_scan/application/commands/select_theme.py:21
msgid "Thème inconnu : {theme_name!r}. Choix : {value}"
msgstr "알 수 없는 테마: {theme_name!r}. 선택지: {value}"

#: src/omega_scan/application/pipeline/guards/authorization_guard.py:33
msgid "Cible {normalized_host!r} non autorisée : ni épinglée, ni confirmation explicite fournie pour ce scan."
msgstr "대상 {normalized_host!r}은(는) 허가되지 않았습니다: 고정되지 않았고 이 스캔에 대한 명시적 확인도 없습니다."

#: src/omega_scan/application/queries/compare_scans.py:29
msgid "Aucun scan trouvé pour l'identifiant {previous_scan_id!r}."
msgstr "ID {previous_scan_id!r}인 스캔을 찾을 수 없습니다."

#: src/omega_scan/application/queries/compare_scans.py:34
msgid "Aucun scan trouvé pour l'identifiant {current_scan_id!r}."
msgstr "ID {current_scan_id!r}인 스캔을 찾을 수 없습니다."

#: src/omega_scan/domain/checks/cookies/service.py:49
#, python-brace-format
msgid "Cookie sans attribut Secure : {get}"
msgstr "Secure 속성이 없는 쿠키: {get}"

#: src/omega_scan/domain/checks/cookies/service.py:55
#, python-brace-format
msgid "Le cookie '{get}' est posé sur une réponse HTTPS sans l'attribut Secure."
msgstr "쿠키 '{get}'이(가) Secure 속성 없이 HTTPS 응답에 설정됩니다."

#: src/omega_scan/domain/checks/cookies/service.py:57
msgid "Le cookie peut être transmis en clair si le site est aussi accessible en HTTP."
msgstr "사이트가 HTTP로도 접근 가능하면 쿠키가 평문으로 전송될 수 있습니다."

#: src/omega_scan/domain/checks/cookies/service.py:59
msgid "Ajouter l'attribut Secure à ce cookie."
msgstr "이 쿠키에 Secure 속성을 추가하세요."

#: src/omega_scan/domain/checks/cookies/service.py:91
#, python-brace-format
msgid "Cookie sans attribut HttpOnly : {get}"
msgstr "HttpOnly 속성이 없는 쿠키: {get}"

#: src/omega_scan/domain/checks/cookies/service.py:96
#, python-brace-format
msgid "Le cookie '{get}' n'a pas l'attribut HttpOnly."
msgstr "쿠키 '{get}'에 HttpOnly 속성이 없습니다."

#: src/omega_scan/domain/checks/cookies/service.py:97
msgid "Le cookie est accessible en JavaScript, ce qui aggrave l'impact d'un XSS."
msgstr "쿠키가 JavaScript에서 접근 가능하여 XSS의 영향이 커집니다."

#: src/omega_scan/domain/checks/cookies/service.py:99
msgid "Ajouter l'attribut HttpOnly si ce cookie n'est pas requis côté client."
msgstr "클라이언트 측에서 이 쿠키가 필요 없다면 HttpOnly 속성을 추가하세요."

#: src/omega_scan/domain/checks/cookies/service.py:132
msgid "l'attribut SameSite est absent"
msgstr "SameSite 속성이 없습니다"

#: src/omega_scan/domain/checks/cookies/service.py:134
msgid "SameSite=None est déclaré sans l'attribut Secure"
msgstr "SameSite=None이 Secure 속성 없이 선언되었습니다"

#: src/omega_scan/domain/checks/cookies/service.py:140
#, python-brace-format
msgid "Cookie à risque CSRF : {get}"
msgstr "CSRF 위험이 있는 쿠키: {get}"

#: src/omega_scan/domain/checks/cookies/service.py:145
#, python-brace-format
msgid "Le cookie '{get}' est à risque : {reason}."
msgstr "쿠키 '{get}'에 위험이 있습니다: {reason}."

#: src/omega_scan/domain/checks/cookies/service.py:146
msgid "Le cookie peut être envoyé lors de requêtes intersites, favorisant les attaques CSRF."
msgstr "쿠키가 교차 사이트 요청에 전송될 수 있어 CSRF 공격을 돕습니다."

#: src/omega_scan/domain/checks/cookies/service.py:148
msgid "Définir SameSite=Lax ou Strict, ou SameSite=None accompagné de Secure."
msgstr "SameSite=Lax 또는 Strict, 또는 Secure와 함께 SameSite=None을 설정하세요."

#: src/omega_scan/domain/checks/cors/service.py:47
msgid "CORS wildcard combiné à des credentials autorisés"
msgstr "CORS 와일드카드와 자격 증명 허용의 조합"

#: src/omega_scan/domain/checks/cors/service.py:53
msgid "Access-Control-Allow-Origin: * est combiné à Access-Control-Allow-Credentials: true."
msgstr "Access-Control-Allow-Origin: *이(가) Access-Control-Allow-Credentials: true와 함께 사용됩니다."

#: src/omega_scan/domain/checks/cors/service.py:56
msgid "N'importe quel site tiers peut lire des réponses authentifiées de l'utilisateur."
msgstr "어떤 제3자 사이트든 사용자의 인증된 응답을 읽을 수 있습니다."

#: src/omega_scan/domain/checks/cors/service.py:58
msgid "Ne jamais combiner un wildcard avec Allow-Credentials ; whitelister les origines."
msgstr "와일드카드를 Allow-Credentials와 절대 함께 쓰지 말고, 출처를 허용 목록으로 관리하세요."

#: src/omega_scan/domain/checks/cors/service.py:83
msgid "Origine arbitraire réfléchie dans Access-Control-Allow-Origin"
msgstr "임의의 출처가 Access-Control-Allow-Origin에 반사됨"

#: src/omega_scan/domain/checks/cors/service.py:89
msgid "Le service reflète telle quelle une origine arbitraire et non reconnue dans Access-Control-Allow-Origin."
msgstr "서비스가 알 수 없는 임의의 출처를 Access-Control-Allow-Origin에 그대로 반사합니다."

#: src/omega_scan/domain/checks/cors/service.py:92
msgid "Absence apparente de validation d'origine : un site tiers peut lire les réponses."
msgstr "출처 검증이 없어 보입니다: 제3자 사이트가 응답을 읽을 수 있습니다."

#: src/omega_scan/domain/checks/cors/service.py:94
msgid "Valider l'origine reçue contre une liste explicite avant de la réfléchir."
msgstr "반사하기 전에 받은 출처를 명시적 목록과 대조해 검증하세요."

#: src/omega_scan/domain/checks/exposure/service.py:39
#, python-brace-format
msgid "Chemin admin accessible : {path}"
msgstr "관리 경로에 접근 가능: {path}"

#: src/omega_scan/domain/checks/exposure/service.py:44
#, python-brace-format
msgid "Le chemin {path} est accessible sans authentification."
msgstr "경로 {path}에 인증 없이 접근할 수 있습니다."

#: src/omega_scan/domain/checks/exposure/service.py:45
msgid "Interface d'administration potentiellement exposée."
msgstr "관리 인터페이스가 노출되었을 수 있습니다."

#: src/omega_scan/domain/checks/exposure/service.py:46
msgid "Restreindre l'accès par IP ou exiger une authentification forte."
msgstr "IP로 접근을 제한하거나 강력한 인증을 요구하세요."

#: src/omega_scan/domain/checks/exposure/service.py:87
#, python-brace-format
msgid "Fichier sensible accessible : {path}"
msgstr "민감한 파일에 접근 가능: {path}"

#: src/omega_scan/domain/checks/exposure/service.py:92
#, python-brace-format
msgid "Le fichier {path} est accessible publiquement."
msgstr "파일 {path}에 공개적으로 접근할 수 있습니다."

#: src/omega_scan/domain/checks/exposure/service.py:93
msgid "Fuite de données sensibles (credentials, configuration)."
msgstr "민감한 데이터 유출(자격 증명, 설정)."

#: src/omega_scan/domain/checks/exposure/service.py:94
msgid "Bloquer l'accès à ces fichiers via la configuration du serveur web."
msgstr "웹 서버 설정에서 이 파일들에 대한 접근을 차단하세요."

#: src/omega_scan/domain/checks/headers/service.py:42
msgid "Content-Security-Policy absente"
msgstr "Content-Security-Policy 없음"

#: src/omega_scan/domain/checks/headers/service.py:47
msgid "Le header Content-Security-Policy est absent sur une page HTML."
msgstr "HTML 페이지에 Content-Security-Policy 헤더가 없습니다."

#: src/omega_scan/domain/checks/headers/service.py:48
msgid "Vulnérable aux attaques XSS et injection de contenu."
msgstr "XSS 공격과 콘텐츠 삽입에 취약합니다."

#: src/omega_scan/domain/checks/headers/service.py:49
msgid "Ajouter un header Content-Security-Policy restrictif."
msgstr "엄격한 Content-Security-Policy 헤더를 추가하세요."

#: src/omega_scan/domain/checks/headers/service.py:99
msgid "Content-Security-Policy trop permissive"
msgstr "Content-Security-Policy가 너무 느슨함"

#: src/omega_scan/domain/checks/headers/service.py:104
#, python-brace-format
msgid "CSP présente mais contient des directives permissives: {join}"
msgstr "CSP가 있으나 느슨한 지시문을 포함합니다: {join}"

#: src/omega_scan/domain/checks/headers/service.py:105
msgid "La protection CSP est affaiblie."
msgstr "CSP 보호가 약화되었습니다."

#: src/omega_scan/domain/checks/headers/service.py:106
msgid "Restreindre les directives CSP (éviter 'unsafe-inline', '*', etc.)."
msgstr "CSP 지시문을 제한하세요('unsafe-inline', '*' 등 지양)."

#: src/omega_scan/domain/checks/headers/service.py:111
#, python-brace-format
msgid "Motifs permissifs détectés: {join}"
msgstr "느슨한 패턴 감지: {join}"

#: src/omega_scan/domain/checks/headers/service.py:150
msgid "X-Content-Type-Options absent ou invalide"
msgstr "X-Content-Type-Options가 없거나 잘못됨"

#: src/omega_scan/domain/checks/headers/service.py:155
msgid "Le header X-Content-Type-Options: nosniff est absent."
msgstr "X-Content-Type-Options: nosniff 헤더가 없습니다."

#: src/omega_scan/domain/checks/headers/service.py:156
msgid "Vulnérable aux attaques MIME sniffing."
msgstr "MIME 스니핑 공격에 취약합니다."

#: src/omega_scan/domain/checks/headers/service.py:157
msgid "Ajouter le header: X-Content-Type-Options: nosniff"
msgstr "헤더 추가: X-Content-Type-Options: nosniff"

#: src/omega_scan/domain/checks/headers/service.py:198 src/omega_scan/domain/checks/information_leaks/service.py:45
msgid "Bannière Server exposée"
msgstr "Server 배너 노출"

#: src/omega_scan/domain/checks/headers/service.py:203
#, python-brace-format
msgid "Le header Server expose des informations: {server}"
msgstr "Server 헤더가 정보를 노출합니다: {server}"

#: src/omega_scan/domain/checks/headers/service.py:204 src/omega_scan/domain/checks/information_leaks/service.py:51
msgid "Fuite d'information sur la technologie serveur."
msgstr "서버 기술에 관한 정보 유출."

#: src/omega_scan/domain/checks/headers/service.py:205 src/omega_scan/domain/checks/information_leaks/service.py:52
msgid "Configurer le serveur pour masquer ou minimiser le header Server."
msgstr "Server 헤더를 숨기거나 최소화하도록 서버를 설정하세요."

#: src/omega_scan/domain/checks/headers/service.py:257
msgid "Cache-Control absent ou permissif"
msgstr "Cache-Control이 없거나 느슨함"

#: src/omega_scan/domain/checks/headers/service.py:263
msgid "Le header Cache-Control est absent ou ne restreint pas explicitement la mise en cache (valeur observée : {cache_control!r})."
msgstr "Cache-Control 헤더가 없거나 캐시를 명시적으로 제한하지 않습니다(관찰된 값: {cache_control!r})."

#: src/omega_scan/domain/checks/headers/service.py:266
msgid "Du contenu potentiellement sensible pourrait être conservé par des caches partagés."
msgstr "민감할 수 있는 콘텐츠가 공유 캐시에 보관될 수 있습니다."

#: src/omega_scan/domain/checks/headers/service.py:268
msgid "Définir Cache-Control: no-store (ou private) sur les réponses porteuses de données utilisateur."
msgstr "사용자 데이터를 담은 응답에 Cache-Control: no-store(또는 private)를 설정하세요."

#: src/omega_scan/domain/checks/information_leaks/service.py:50
#, python-brace-format
msgid "Le header Server expose des informations : {server}"
msgstr "Server 헤더가 정보를 노출합니다: {server}"

#: src/omega_scan/domain/checks/information_leaks/service.py:71
msgid "Bannière X-Powered-By exposée"
msgstr "X-Powered-By 배너 노출"

#: src/omega_scan/domain/checks/information_leaks/service.py:76
#, python-brace-format
msgid "Le header X-Powered-By expose des informations : {powered_by}"
msgstr "X-Powered-By 헤더가 정보를 노출합니다: {powered_by}"

#: src/omega_scan/domain/checks/information_leaks/service.py:77
msgid "Fuite d'information sur le framework/technologie."
msgstr "프레임워크/기술에 관한 정보 유출."

#: src/omega_scan/domain/checks/information_leaks/service.py:78
msgid "Supprimer le header X-Powered-By de la configuration."
msgstr "설정에서 X-Powered-By 헤더를 제거하세요."

#: src/omega_scan/domain/checks/information_leaks/service.py:119
msgid "Messages d'erreur détaillés exposés"
msgstr "상세한 오류 메시지 노출"

#: src/omega_scan/domain/checks/information_leaks/service.py:124
#, python-brace-format
msgid "Des messages d'erreur détaillés sont visibles dans la réponse : {join}"
msgstr "응답에 상세한 오류 메시지가 보입니다: {join}"

#: src/omega_scan/domain/checks/information_leaks/service.py:125
msgid "Fuite d'information sur l'implémentation, potentiellement exploitable."
msgstr "구현에 관한 정보 유출로, 악용될 수 있습니다."

#: src/omega_scan/domain/checks/information_leaks/service.py:126
msgid "Configurer le serveur pour afficher des pages d'erreur génériques en production."
msgstr "운영 환경에서는 일반적인 오류 페이지를 표시하도록 서버를 설정하세요."

#: src/omega_scan/domain/checks/information_leaks/service.py:173
msgid "Stack trace exposé"
msgstr "스택 트레이스 노출"

#: src/omega_scan/domain/checks/information_leaks/service.py:178
#, python-brace-format
msgid "Un stack trace est visible dans la réponse : {join}"
msgstr "응답에 스택 트레이스가 보입니다: {join}"

#: src/omega_scan/domain/checks/information_leaks/service.py:179
msgid "Fuite d'information critique sur l'implémentation, paths internes, versions."
msgstr "구현, 내부 경로, 버전에 관한 치명적인 정보 유출."

#: src/omega_scan/domain/checks/information_leaks/service.py:181
msgid "Désactiver l'affichage des stack traces en production. Utiliser des pages d'erreur génériques."
msgstr "운영 환경에서 스택 트레이스 표시를 끄세요. 일반적인 오류 페이지를 사용하세요."

#: src/omega_scan/domain/checks/information_leaks/service.py:217
msgid "Fichier robots.txt présent"
msgstr "robots.txt 파일 있음"

#: src/omega_scan/domain/checks/information_leaks/service.py:222
msgid "Le fichier /robots.txt est présent et peut révéler des chemins sensibles."
msgstr "/robots.txt 파일이 있으며 민감한 경로를 드러낼 수 있습니다."

#: src/omega_scan/domain/checks/information_leaks/service.py:224
msgid "Fuite d'information mineure sur la structure du site."
msgstr "사이트 구조에 관한 경미한 정보 유출."

#: src/omega_scan/domain/checks/information_leaks/service.py:225
msgid "Vérifier que /robots.txt ne liste pas de chemins sensibles ou administratifs."
msgstr "/robots.txt에 민감하거나 관리용 경로가 나열되지 않았는지 확인하세요."

#: src/omega_scan/domain/checks/information_leaks/service.py:233
#, python-brace-format
msgid "{get}://{get2}/robots.txt"
msgstr "{get}://{get2}/robots.txt"

#: src/omega_scan/domain/checks/information_leaks/service.py:262
msgid "Fichier security.txt présent"
msgstr "security.txt 파일 있음"

#: src/omega_scan/domain/checks/information_leaks/service.py:267
msgid "Le fichier /.well-known/security.txt est présent (RFC 9116)."
msgstr "/.well-known/security.txt 파일이 있습니다(RFC 9116)."

#: src/omega_scan/domain/checks/information_leaks/service.py:268
msgid "Bonne pratique : facilite le signalement responsable de vulnérabilités."
msgstr "좋은 관행: 책임 있는 취약점 신고를 쉽게 해 줍니다."

#: src/omega_scan/domain/checks/information_leaks/service.py:269 src/omega_scan/domain/checks/transport/service.py:130
msgid "Aucune action requise."
msgstr "조치가 필요하지 않습니다."

#: src/omega_scan/domain/checks/information_leaks/service.py:277
#, python-brace-format
msgid "{get}://{get2}/.well-known/security.txt"
msgstr "{get}://{get2}/.well-known/security.txt"

#: src/omega_scan/domain/checks/information_leaks/service.py:323
#, python-brace-format
msgid "Header technique exposé : {verbose_header}"
msgstr "기술 헤더 노출: {verbose_header}"

#: src/omega_scan/domain/checks/information_leaks/service.py:328
#, python-brace-format
msgid "Le header {verbose_header} expose des informations techniques : {value}"
msgstr "헤더 {verbose_header}이(가) 기술 정보를 노출합니다: {value}"

#: src/omega_scan/domain/checks/information_leaks/service.py:330
msgid "Fuite d'information sur l'implémentation."
msgstr "구현에 관한 정보 유출."

#: src/omega_scan/domain/checks/information_leaks/service.py:331
#, python-brace-format
msgid "Supprimer le header {verbose_header} de la configuration."
msgstr "설정에서 헤더 {verbose_header}을(를) 제거하세요."

#: src/omega_scan/domain/checks/methods/policies.py:12
msgid "Méthode HTTP OPTIONS activée"
msgstr "HTTP OPTIONS 메서드 활성화"

#: src/omega_scan/domain/checks/methods/policies.py:15
msgid "La méthode OPTIONS est activée et peut révéler les méthodes autorisées."
msgstr "OPTIONS 메서드가 활성화되어 허용된 메서드를 드러낼 수 있습니다."

#: src/omega_scan/domain/checks/methods/policies.py:16
msgid "Fuite d'information mineure sur la configuration du serveur."
msgstr "서버 설정에 관한 경미한 정보 유출."

#: src/omega_scan/domain/checks/methods/policies.py:17
msgid "Désactiver la méthode OPTIONS si elle n'est pas nécessaire."
msgstr "필요 없다면 OPTIONS 메서드를 비활성화하세요."

#: src/omega_scan/domain/checks/methods/policies.py:21
msgid "Méthode HTTP TRACE activée"
msgstr "HTTP TRACE 메서드 활성화"

#: src/omega_scan/domain/checks/methods/policies.py:24
msgid "La méthode TRACE est activée, ce qui peut faciliter les attaques Cross-Site Tracing (XST)."
msgstr "TRACE 메서드가 활성화되어 크로스 사이트 트레이싱(XST) 공격을 쉽게 할 수 있습니다."

#: src/omega_scan/domain/checks/methods/policies.py:26
msgid "Risque de vol de cookies ou d'identifiants via XST."
msgstr "XST를 통한 쿠키나 자격 증명 탈취 위험."

#: src/omega_scan/domain/checks/methods/policies.py:27
msgid "Désactiver la méthode TRACE dans la configuration du serveur web."
msgstr "웹 서버 설정에서 TRACE 메서드를 비활성화하세요."

#: src/omega_scan/domain/checks/methods/policies.py:31
msgid "Méthode HTTP PUT activée"
msgstr "HTTP PUT 메서드 활성화"

#: src/omega_scan/domain/checks/methods/policies.py:34
msgid "La méthode PUT est activée, permettant potentiellement l'upload de fichiers."
msgstr "PUT 메서드가 활성화되어 파일 업로드가 가능할 수 있습니다."

#: src/omega_scan/domain/checks/methods/policies.py:36
msgid "Risque de dépôt de contenu malveillant ou de modification de ressources."
msgstr "악성 콘텐츠 배치나 리소스 변경 위험."

#: src/omega_scan/domain/checks/methods/policies.py:37
msgid "Désactiver la méthode PUT sauf si explicitement requise et sécurisée."
msgstr "명시적으로 필요하고 보호된 경우가 아니면 PUT 메서드를 비활성화하세요."

#: src/omega_scan/domain/checks/methods/policies.py:41
msgid "Méthode HTTP DELETE activée"
msgstr "HTTP DELETE 메서드 활성화"

#: src/omega_scan/domain/checks/methods/policies.py:44
msgid "La méthode DELETE est activée, permettant potentiellement la suppression de ressources."
