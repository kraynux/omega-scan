#: src/omega_scan/domain/checks/information_leaks/service.py:328
#, python-brace-format
msgid "Le header {verbose_header} expose des informations techniques : {value}"
msgstr "ヘッダー {verbose_header} が技術情報を露出しています：{value}"

#: src/omega_scan/domain/checks/information_leaks/service.py:330
msgid "Fuite d'information sur l'implémentation."
msgstr "実装に関する情報の漏えい。"

#: src/omega_scan/domain/checks/information_leaks/service.py:331
