#: src/omega_scan/interfaces/tui/screens/help_screen.py:55
msgid "Saisir une cible (IPv4, IPv6, hostname ou URL), choisir un profil (quick/standard/extended/local-lab), confirmer l'autorisation si la cible n'est pas déjà épinglée, puis lancer le scan."
msgstr "Podaj cel (IPv4, IPv6, nazwa hosta lub URL), wybierz profil (quick/standard/extended/local-lab), potwierdź autoryzację, jeśli cel nie jest jeszcze przypięty, a następnie uruchom skan."

#: src/omega_scan/interfaces/tui/screens/help_screen.py:63
msgid "Épingler un hôte dispense de recocher la confirmation d'autorisation à chaque scan sur cette même cible."
msgstr "Przypięcie hosta zwalnia z ponownego zaznaczania potwierdzenia autoryzacji przy każdym skanie tego samego celu."

#: src/omega_scan/interfaces/tui/screens/help_screen.py:70
msgid "Liste tous les scans passés : détail complet, comparaison entre deux scans, ou rejouer un scan sur la même cible."
